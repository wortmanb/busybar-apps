[Unit]
Description=busybar-apps pull-based deploy — 3-minute poll
Documentation=https://github.com/wortmanb/busybar-apps/blob/main/docs/DEPLOY-SELF-HOSTED.md

[Timer]
# First run 1 min after boot (repo may not be initialised yet)
OnBootSec=1min
# Then every 3 minutes
OnUnitActiveSec=3min
Unit=busybar-deploy.service
# Jitter up to 30s to avoid thundering herd if multiple hosts
RandomizedDelaySec=30

[Install]
WantedBy=timers.target
